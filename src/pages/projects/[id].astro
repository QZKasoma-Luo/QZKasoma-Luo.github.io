---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isPublic } from '../../lib/content';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter(isPublic);
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);

const kindLabel: Record<string, string> = {
  research: 'Research',
  group: 'Group project',
  independent: 'Independent',
  coursework: 'Coursework',
  project: 'Project',
};
const statusLabel: Record<string, string> = {
  completed: 'Completed',
  'in-progress': 'In progress',
};

const linkEntries = [
  project.data.links.repo && { label: 'Repository', href: project.data.links.repo },
  project.data.links.demo && { label: 'Demo', href: project.data.links.demo },
  project.data.links.paper && { label: 'Paper', href: project.data.links.paper },
  project.data.links.doi && { label: 'DOI', href: project.data.links.doi },
].filter(Boolean) as { label: string; href: string }[];
---

<BaseLayout
  title={`${project.data.title} — Qingze Luo`}
  description={project.data.summary}
>
  <div class="wrap detail">
    <a class="back-link" href="/projects/">← All projects</a>
    {!project.data.verified ? (
      <p class="draft-note">Draft content — pending résumé verification</p>
    ) : null}

    <header class="detail-head">
      <p class="kind">{kindLabel[project.data.kind]} · {project.data.year}</p>
      <h1>{project.data.title}</h1>
      <p class="lede">{project.data.summary}</p>
      <div class="detail-meta">
        <span>Status <strong>{statusLabel[project.data.status]}</strong></span>
        {project.data.role ? <span>Role <strong>{project.data.role}</strong></span> : null}
        {project.data.team ? <span>Team <strong>{project.data.team}</strong></span> : null}
      </div>
      <div class="tags">
        {project.data.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
      {linkEntries.length ? (
        <div class="detail-actions">
          {linkEntries.map((link) => (
            <a class="btn btn-ghost" href={link.href} target="_blank" rel="noreferrer">
              {link.label} ↗
            </a>
          ))}
        </div>
      ) : null}
    </header>

    {project.data.kind === 'group' ? (
      <aside class="notice">
        <strong>Group project.</strong> This work was completed with teammates; the repository
        and the résumé are the source of truth for individual contributions.
      </aside>
    ) : null}

    {project.data.kind === 'independent' && project.data.deployed === false ? (
      <aside class="notice">
        <strong>Internal prototype.</strong> Built as an internal tool; it was not deployed to
        production.
      </aside>
    ) : null}

    <div class="prose article-body">
      <Content />
    </div>
  </div>
</BaseLayout>

<style>
  .detail {
    padding-block: 46px 80px;
  }
  .kind {
    margin: 0 0 12px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  h1 {
    max-width: 24ch;
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 300;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .lede {
    max-width: 62ch;
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.63;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 18px;
  }
  .notice {
    max-width: 68ch;
    margin: 30px 0 0;
    padding: 14px 16px;
    border-left: 2px solid var(--accent);
    background: var(--paper-2);
    color: var(--ink-soft);
    font-size: 0.84rem;
    line-height: 1.55;
  }
  .article-body {
    margin-top: 36px;
  }
  @media (max-width: 620px) {
    .detail {
      padding-block: 30px 56px;
    }
  }
</style>
