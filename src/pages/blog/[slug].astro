---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isPublic } from '../../lib/content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(isPublic);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormat = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${post.data.title} — Qingze Luo`} description={post.data.description}>
  <article class="wrap article">
    <a class="back-link" href="/blog/">← All writing</a>
    {import.meta.env.DEV && post.data.draft ? (
      <p class="draft-note">Draft — not published</p>
    ) : null}

    <header class="post-header">
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>{dateFormat.format(post.data.date)}</time>
        {post.data.courseNotes ? <span>Course notes</span> : null}
        {post.data.tags.map((tag) => <span>{tag}</span>)}
      </div>
      <h1>{post.data.title}</h1>
      <p class="post-desc">{post.data.description}</p>
    </header>

    <div class="prose article-body">
      <Content />
    </div>
  </article>
</BaseLayout>
