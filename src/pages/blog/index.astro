---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BLOG_CATEGORIES, blogCategoryLabel, isPublic } from '../../lib/content';

const posts = (await getCollection('blog'))
  .filter(isPublic)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFormat = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout
  title="Blog — Qingze Luo"
  description="Notes on privacy, systems, coursework, and learning in public by Qingze Luo."
>
  <div class="wrap page-head">
    <p class="eyebrow">Notes &amp; essays</p>
    <h1>Blog</h1>
    <p class="page-lead">
      Short notes on privacy, systems, coursework, and the process of learning in public.
      Longer pieces are added when they are ready, not to fill a feed.
    </p>
  </div>

  {posts.length > 0 ? (
    <div class="wrap blog-tools">
      <div class="blog-filters" role="group" aria-label="Filter by category">
        <button type="button" class="filter-btn" data-blog-filter="all" aria-pressed="true">All</button>
        {BLOG_CATEGORIES.map((category) => (
          <button type="button" class="filter-btn" data-blog-filter={category.id} aria-pressed="false">{category.label}</button>
        ))}
      </div>
      <label class="visually-hidden" for="blog-search">Search posts</label>
      <input class="blog-search" id="blog-search" type="search" placeholder="Search posts" autocomplete="off" />
    </div>
  ) : null}

  <div class="wrap blog-list" id="blog-posts">
    {posts.length > 0 ? (
      posts.map((post) => (
        <a class="post" href={`/blog/${post.id}/`} data-category={post.data.category}>
          <time datetime={post.data.date.toISOString()}>{dateFormat.format(post.data.date)}</time>
          <span class="post-main">
            <span class="post-tags">
              {post.data.draft ? <span class="tag">Draft</span> : null}
              <span class="tag tag-accent">{blogCategoryLabel(post.data.category)}</span>
              {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </span>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
          </span>
        </a>
      ))
    ) : (
      <div class="empty-card">
        <p>The first notes are being written. The RSS feed will be the quiet way to know when they land.</p>
        <a href="/rss.xml">Subscribe via RSS →</a>
      </div>
    )}
    <p class="blog-empty" id="blog-empty" aria-live="polite" hidden>No posts match these filters.</p>
  </div>
</BaseLayout>

<script is:inline>
  // The filter and search run on the rendered page, so they work on the
  // translated pages too: the query is matched against the visible text.
  (() => {
    const list = document.getElementById('blog-posts');
    if (!list) return;
    const posts = Array.from(list.querySelectorAll('.post'));
    if (posts.length === 0) return;

    const buttons = Array.from(document.querySelectorAll('[data-blog-filter]'));
    const search = document.getElementById('blog-search');
    const empty = document.getElementById('blog-empty');
    let filter = 'all';

    const normalize = (value) => value.normalize('NFKC').toLowerCase();

    const apply = () => {
      const query = normalize(search?.value ?? '').trim();
      const tokens = query.split(/\s+/).filter(Boolean);
      let visible = 0;
      for (const post of posts) {
        const text = normalize(post.textContent ?? '');
        const matchesFilter = filter === 'all' || post.dataset.category === filter;
        const matchesQuery = tokens.every((token) => text.includes(token));
        const show = matchesFilter && matchesQuery;
        post.hidden = !show;
        if (show) {
          post.classList.toggle('is-first', visible === 0);
          visible += 1;
        }
      }
      if (empty) empty.hidden = visible !== 0;
    };

    for (const button of buttons) {
      button.addEventListener('click', () => {
        filter = button.dataset.blogFilter ?? 'all';
        for (const other of buttons) {
          other.setAttribute('aria-pressed', String(other === button));
        }
        apply();
      });
    }
    search?.addEventListener('input', apply);
    search?.addEventListener('search', apply);
    apply();
  })();
</script>

<style>
  .blog-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding-bottom: 24px;
  }
  .blog-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .filter-btn {
    padding: 7px 13px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.18s var(--ease), border-color 0.18s var(--ease), background 0.18s var(--ease);
  }
  .filter-btn:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }
  .filter-btn[aria-pressed="true"] {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }
  .blog-search {
    width: 250px;
    max-width: 100%;
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 0.82rem;
  }
  .blog-search::placeholder {
    color: var(--muted);
  }
  .blog-search:focus-visible {
    outline-offset: 2px;
  }
  .blog-list {
    padding-bottom: 80px;
  }
  .post {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 30px;
    padding: 26px 0 28px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .post[hidden] {
    display: none;
  }
  .post:first-child,
  .post.is-first {
    border-top: 1px solid var(--line);
  }
  time {
    padding-top: 5px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-bottom: 8px;
  }
  h2 {
    margin-bottom: 6px;
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
    font-weight: 300;
    line-height: 1.14;
    letter-spacing: -0.02em;
  }
  p {
    max-width: 64ch;
    margin: 0;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.55;
  }
  .post:hover h2 {
    color: var(--green);
  }
  .blog-empty {
    margin: 0;
    padding-top: 26px;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .empty-card {
    padding: 28px 30px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .empty-card p {
    margin: 0 0 12px;
    color: var(--muted);
  }
  .empty-card a {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }
  @media (max-width: 620px) {
    .blog-tools {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }
    .blog-search {
      width: 100%;
    }
    .post {
      grid-template-columns: 1fr;
      gap: 5px;
    }
    time {
      padding-top: 0;
    }
  }
</style>
