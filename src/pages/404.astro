---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Qingze Luo" description="That page does not exist." noindex>
  <div class="wrap page-head">
    <p class="eyebrow">404</p>
    <h1>That page isn’t here.</h1>
    <p class="page-lead">The link may be old, or the page may have moved. The home page is a good place to start.</p>
    <div class="detail-actions">
      <a class="btn btn-solid" href="/">Back home</a>
      <a class="btn btn-ghost" href="/blog/">Blog</a>
    </div>
  </div>
</BaseLayout>
