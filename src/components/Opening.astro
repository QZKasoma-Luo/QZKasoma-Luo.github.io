---
---

<div id="qz-intro" class="intro" hidden aria-hidden="true">
  <div class="intro-stage">
    <div class="intro-kicker">
      <span>Portfolio</span>
      <span>2026 / 27</span>
    </div>

    <svg class="intro-mark" viewBox="0 0 160 120" fill="none" aria-hidden="true">
      <circle class="reticle reticle-a" cx="80" cy="60" r="50" />
      <circle class="reticle reticle-b" cx="80" cy="60" r="38" />
      <circle class="draw q" cx="56" cy="56" r="30" pathLength="1" />
      <path class="draw q-tail" d="M77 77 96 96" pathLength="1" />
      <path class="draw l" d="M112 26V84" pathLength="1" />
      <path class="draw l-foot" d="M112 84H142" pathLength="1" />
      <path class="scan" d="M8 56H152" pathLength="1" />
      <circle class="spark" cx="152" cy="56" r="2.2" />
    </svg>

    <p class="intro-name"><span>Qingze</span> <span>Luo</span></p>
    <p class="intro-meta">Security · Privacy · Software</p>
    <div class="intro-rule" aria-hidden="true"></div>
    <p class="intro-hint">Click or press any key to skip</p>
  </div>
</div>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #070706;
    color: #0a0a0a;
    padding: 28px;
    animation: intro-in 0.18s var(--ease) both;
  }
  .intro[hidden] {
    display: none;
  }
  .intro[data-state="leaving"] {
    animation: intro-out 0.2s ease-in both;
  }

  .intro::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 90% at 78% 12%, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0) 55%),
      linear-gradient(to right, rgba(10, 10, 10, 0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(10, 10, 10, 0.045) 1px, transparent 1px),
      linear-gradient(168deg, #eceae6 0%, #e5e3df 42%, #e5e3df 100%);
    background-size: auto, 56px 56px, 56px 56px, auto;
    background-repeat: no-repeat, repeat, repeat, no-repeat;
    opacity: 0;
    animation: plate-in 0.45s 0.08s ease-out forwards;
    pointer-events: none;
  }
  .intro::after {
    content: "";
    position: absolute;
    width: 70vmax;
    height: 70vmax;
    left: 50%;
    top: 46%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 117, 0, 0.1), rgba(255, 117, 0, 0) 62%);
    pointer-events: none;
  }

  .intro-stage {
    position: relative;
    z-index: 1;
    width: min(760px, 84vw);
    text-align: center;
    animation: stage-glitch 0.2s 1.56s steps(2) both;
  }

  .intro-kicker {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(10, 10, 10, 0.62);
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(10, 10, 10, 0.16);
    opacity: 0;
    animation: rise 0.34s 0.04s var(--ease) both;
  }

  .intro-mark {
    display: block;
    width: min(520px, 78%);
    margin: 40px auto 18px;
    overflow: visible;
  }
  .intro-mark .draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .intro-mark .q,
  .intro-mark .q-tail,
  .intro-mark .l {
    stroke: #0a0a0a;
    stroke-width: 2.4;
    stroke-linecap: round;
  }
  .intro-mark .l-foot {
    stroke: #ff7500;
    stroke-width: 2.4;
    stroke-linecap: round;
  }
  .intro-mark .reticle {
    fill: none;
    stroke: rgba(10, 10, 10, 0.24);
    stroke-width: 1;
    stroke-dasharray: 2 7;
    transform-origin: 80px 60px;
    animation: spin 24s linear infinite;
  }
  .intro-mark .reticle-b {
    stroke-dasharray: 1 9;
    opacity: 0.65;
    animation-direction: reverse;
    animation-duration: 18s;
  }
  .intro-mark .q {
    animation: draw 0.5s 0.12s cubic-bezier(0.65, 0, 0.35, 1) both;
  }
  .intro-mark .q-tail {
    animation: draw 0.34s 0.38s cubic-bezier(0.65, 0, 0.35, 1) both;
  }
  .intro-mark .l {
    animation: draw 0.38s 0.3s cubic-bezier(0.65, 0, 0.35, 1) both;
  }
  .intro-mark .l-foot {
    animation: draw 0.24s 0.52s ease-out both;
  }
  .intro-mark .scan {
    stroke: rgba(255, 117, 0, 0.9);
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 0.34s 0.56s ease-out both;
  }
  .intro-mark .spark {
    fill: #ff7500;
    opacity: 0;
    animation: spark 0.3s 0.78s ease-out both;
  }

  .intro-name {
    margin: 8px 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 7.4vw, 4.6rem);
    font-weight: 400;
    letter-spacing: 0.11em;
    line-height: 1;
    text-transform: uppercase;
    display: flex;
    justify-content: center;
    gap: 0.38em;
    flex-wrap: wrap;
  }
  .intro-name span {
    display: inline-block;
    opacity: 0;
    transform: translateY(7px);
    animation: rise 0.38s 0.92s var(--ease) both;
  }
  .intro-name span:last-child {
    animation-delay: 1.04s;
  }

  .intro-meta {
    margin: 18px 0 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #a83a22;
    opacity: 0;
    animation: rise 0.34s 1.18s var(--ease) both;
  }

  .intro-rule {
    width: 100%;
    height: 1px;
    margin-top: 30px;
    background: linear-gradient(to right, transparent, rgba(10, 10, 10, 0.45), transparent);
    transform: scaleX(0);
    animation: rule 0.4s 1.1s var(--ease) both;
  }

  .intro-hint {
    margin: 14px 0 0;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(10, 10, 10, 0.55);
    opacity: 0;
    animation: fade 0.34s 1.26s ease-out both;
  }

  @keyframes intro-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes plate-in {
    to { opacity: 1; }
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  @keyframes stage-glitch {
    0%, 100% { transform: translateX(0); filter: none; }
    25% { transform: translateX(-3px); filter: drop-shadow(1px 0 rgba(255, 59, 48, 0.45)) drop-shadow(-1px 0 rgba(41, 113, 184, 0.45)); }
    50% { transform: translateX(3px); filter: drop-shadow(-1px 0 rgba(255, 59, 48, 0.45)) drop-shadow(1px 0 rgba(41, 113, 184, 0.45)); }
    75% { transform: translateX(-1px); filter: none; }
  }
  @keyframes intro-out {
    from { opacity: 1; }
    to { opacity: 0; }
  }
  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes rule {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  @keyframes spark {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (max-width: 620px) {
    .intro-stage {
      width: 88vw;
    }
    .intro-mark {
      margin-top: 32px;
      width: 78%;
    }
    .intro-name {
      letter-spacing: 0.08em;
      gap: 0.3em;
    }
    .intro-kicker {
      font-size: 0.54rem;
    }
    .intro-hint {
      font-size: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro {
      display: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const el = document.getElementById('qz-intro');
    if (!el) return;

    const root = document.documentElement;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const skip = new URLSearchParams(location.search).get('intro') === 'off';

    if (reduceMotion || skip) return;

    el.hidden = false;
    el.dataset.state = 'playing';
    root.classList.add('intro-active');

    let closed = false;
    let timer = 0;

    const cleanup = () => {
      window.removeEventListener('keydown', onKey);
      window.removeEventListener('pointerdown', onPointer);
      root.classList.remove('intro-active');
    };

    const close = () => {
      if (closed) return;
      closed = true;
      window.clearTimeout(timer);
      cleanup();
      el.dataset.state = 'leaving';
      window.setTimeout(() => el.remove(), 210);
    };

    const onKey = () => close();
    const onPointer = () => close();

    window.addEventListener('keydown', onKey, { passive: true });
    window.addEventListener('pointerdown', onPointer, { passive: true });
    timer = window.setTimeout(close, 1780);
  })();
</script>
